<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="default" transaction-type="JTA">
        <!-- ✅ Ensure this matches your WildFly JNDI Datasource Name -->
        <jta-data-source>java:jboss/datasources/PostgreSQLDS</jta-data-source>

        <!-- ✅ Add Your Entity Classes -->
        <class>com.example.td2karenjpa.Employee</class>

        <properties>
            <!-- ✅ Correct JTA Platform for WildFly -->
            <property name="hibernate.transaction.jta.platform"
                      value="org.hibernate.service.jta.platform.internal.JBossAppServerJtaPlatform"/>

            <!-- ✅ Ensure Database Schema Auto-Update -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- ✅ Disable Autocommit Issues -->
            <property name="hibernate.connection.provider_disables_autocommit" value="true"/>

            <!-- ✅ Enable SQL Logging for Debugging -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
